<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <AssemblyName>QuickLauncher</AssemblyName>
   <ImplicitUsings>enable</ImplicitUsings>
   <Nullable>enable</Nullable>
   <OutputType>WinExe</OutputType>
   <!-- <TargetFramework>net10.0-windows</TargetFramework> -->
   <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
   <UseWindowsForms>true</UseWindowsForms>
   <ApplicationIcon>Res\terminal.ico</ApplicationIcon>
   <Platforms>x86;x64</Platforms>
</PropertyGroup>

   <PropertyGroup Condition="'$(TargetFramework)' != ''">
      <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
      <OutputPath>..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
      <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
      <PlatformTarget>$(Platform)</PlatformTarget>
   </PropertyGroup>

   <ItemGroup>
   <Content Include="Res\terminal.ico" />
</ItemGroup>

<ItemGroup>
   <Compile Update="Res\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
   </Compile>
</ItemGroup>

<ItemGroup>
   <EmbeddedResource Update="Res\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
   </EmbeddedResource>
</ItemGroup>

</Project>